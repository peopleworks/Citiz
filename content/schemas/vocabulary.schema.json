{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citiz.dev/schemas/vocabulary.schema.json",
  "title": "Citiz English test vocabulary list",
  "type": "object",
  "required": ["kind", "reviewStatus", "sources", "groups"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "type": "string", "enum": ["reading", "writing"] },
    "reviewStatus": { "$ref": "common.schema.json#/$defs/reviewStatus" },
    "sources": { "$ref": "common.schema.json#/$defs/sources" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "words"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1, "description": "Official heading, e.g. People, Civics, Places, Holidays, Question Words, Verbs, Other (Function), Other (Content)." },
          "words": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
