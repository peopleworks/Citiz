{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citiz.dev/schemas/common.schema.json",
  "title": "Citiz shared definitions",
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Calendar date, YYYY-MM-DD."
    },
    "nullableDate": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft", "needs-review", "approved", "outdated"],
      "description": "Editorial state. See Docs/Editorial/EDR-0002-review-states.md."
    },
    "source": {
      "type": "object",
      "required": ["authority", "title", "url", "verifiedOn", "license"],
      "additionalProperties": false,
      "properties": {
        "authority": { "type": "string", "minLength": 1, "description": "Publishing body, e.g. USCIS." },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "verifiedOn": { "$ref": "#/$defs/nullableDate", "description": "When a maintainer last compared the content with this source; null if never." },
        "license": { "type": "string", "minLength": 1, "description": "Reuse terms, e.g. Public domain (U.S. Government work)." }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  }
}
