<Project>

  <!--
    Repo-wide build settings, imported before every .csproj. A project can still override a value
    by re-declaring it. src/ and tests/ each add their own Directory.Build.props on top of this one.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Warnings are errors everywhere, including NuGet audit warnings (NU19xx). A vulnerable
         transitive package fails the build on purpose: this app is aimed at people preparing an
         immigration application, and "we shipped a known CVE" is not a story we want to tell. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Documentation files are generated everywhere because the unused-usings rule (IDE0005) only
         runs at build when they are. Libraries under src/ must document their public surface
         (CS1591); hosts and tests turn that one warning off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- Reproducible builds and Source Link. The GitHub Source Link provider ships in the SDK since
         .NET 8, so PublishRepositoryUrl is all it takes. ContinuousIntegrationBuild normalizes paths
         in the PDB so two CI builds of one commit are byte-identical; it stays off locally because
         normalized paths break step-through debugging. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Package identity, for the day the engines ship on NuGet (see ROADMAP.md). -->
    <Authors>Citiz Contributors</Authors>
    <Company>Citiz</Company>
    <Product>Citiz</Product>
    <Copyright>Copyright (c) 2026 Citiz Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/peopleworks/Citiz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peopleworks/Citiz</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
    <VersionPrefix>0.4.0</VersionPrefix>
  </PropertyGroup>

</Project>
