@page "/settings"
@inherits LocalizedComponentBase
@inject LearnerState Learner
@inject ContentRepository Content
@inject BrowserStorage Browser
@inject IFileExporter Exporter
@inject ISpeechService Speech
@inject AudioService Audio

<PageTitle>@L.T("settings.title") — @L.T("app.name")</PageTitle>

<PageHeader Title="@L.T("settings.title")" Lead="@L.T("settings.subtitle")" />

@if (error is not null)
{
  <p class="notice bad" role="alert">@error</p>
}

<div class="stack">
  <section class="card" aria-labelledby="profile">
    <h2 id="profile">@L.T("settings.profile")</h2>
    <p class="muted small">@L.T("settings.profileHint")</p>
    <label class="field" style="max-width: 24rem; margin-block-start: 1rem"><span>@L.T("profile.name")</span>
      <input type="text" value="@name" placeholder="@L.T("profile.namePlaceholder")" @onchange="@(e => NameAsync(e.Value?.ToString()))" />
      <span class="hint">@L.T("profile.nameHint")</span>
    </label>
  </section>

  <section class="card" aria-labelledby="languages">
    <h2 id="languages">@L.T("settings.languages")</h2>
    <p class="muted small">@L.T("settings.languagesHint")</p>
    <div class="grid three">
      <label class="field"><span>@L.T("language.interface")</span>
        <select value="@L.Profile.InterfaceCulture" @onchange="@(e => ProfileAsync(L.Profile with { InterfaceCulture = e.Value!.ToString()!, HelpCulture = e.Value.ToString()! }))">
          @foreach (var language in SupportedLanguages.All) { <option value="@language.Code" lang="@language.Code">@language.NativeName</option> }
        </select>
        <span class="hint">@L.T($"language.status.{StatusKey(L.Language.Status)}")</span>
      </label>
      <label class="field"><span>@L.T("language.study")</span>
        <select value="@L.Profile.StudyCulture" @onchange="@(e => ProfileAsync(L.Profile with { StudyCulture = e.Value!.ToString()! }))">
          @foreach (var language in SupportedLanguages.StudyLanguages) { <option value="@language.Code" lang="@language.Code">@language.NativeName</option> }
        </select>
      </label>
      <label class="field"><span>@L.T("language.help")</span>
        <select value="@L.Profile.HelpCulture" @onchange="@(e => ProfileAsync(L.Profile with { HelpCulture = e.Value!.ToString()! }))">
          @foreach (var language in SupportedLanguages.All) { <option value="@language.Code" lang="@language.Code">@language.NativeName</option> }
        </select>
      </label>
    </div>
  </section>

  <section class="card" aria-labelledby="exam">
    <h2 id="exam">@L.T("settings.exam")</h2>
    <div class="grid two">
      <label class="field"><span>@L.T("exam.filingDate")</span>
        <input type="date" value="@filingDate" @onchange="@(e => FilingDateAsync(e.Value?.ToString()))" />
        <span class="hint">@L.T("exam.filingDateHint")</span>
      </label>
      <label class="field"><span>@L.T("exam.version")</span>
        <select value="@(Learner.Exam.VersionId ?? string.Empty)" @onchange="@(e => VersionAsync(e.Value?.ToString()))">
          <option value="">@L.T("exam.versionAuto")</option>
          @foreach (var version in versions) { <option value="@version.Id">@version.DisplayName</option> }
        </select>
      </label>
    </div>
    @if (resolved is not null)
    {
      <p class="notice ok" role="status">@L.T("exam.resolved", resolved.DisplayName)</p>
    }
    else if (Learner.Exam.FilingDate is not null && Learner.Exam.VersionId is null)
    {
      <p class="notice warn" role="status">@L.T("exam.unresolved")</p>
    }
    <label class="check" style="margin-block-start: .75rem">
      <input type="checkbox" checked="@Learner.Exam.SeniorConsideration" @onchange="@(e => SeniorAsync((bool)e.Value!))" />
      <span>@L.T("exam.senior")</span>
    </label>
    <label class="field" style="max-width: 20rem; margin-block-start: 1rem"><span>@L.T("exam.interviewDate")</span>
      <input type="date" value="@interviewDate" @onchange="@(e => InterviewDateAsync(e.Value?.ToString()))" />
      <span class="hint">@L.T("exam.interviewDateHint")</span>
    </label>
  </section>

  <section class="card" aria-labelledby="appearance">
    <h2 id="appearance">@L.T("settings.appearance")</h2>
    <p class="muted small">@L.T("settings.appearanceHint")</p>
    <div class="segmented" role="group" aria-label="@L.T("settings.appearance")" style="margin-block-start: 1rem">
      <button type="button" aria-pressed="@(Learner.Theme == "light" ? "true" : "false")" @onclick='@(() => ThemeAsync("light"))'>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2.5M12 19v2.5M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2.5 12h2.5M19 12h2.5M4.2 19.8L6 18M18 6l1.8-1.8" /></svg>
        @L.T("theme.light")
      </button>
      <button type="button" aria-pressed="@(Learner.Theme == "dark" ? "true" : "false")" @onclick='@(() => ThemeAsync("dark"))'>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" /></svg>
        @L.T("theme.dark")
      </button>
      <button type="button" aria-pressed="@(Learner.Theme is null ? "true" : "false")" @onclick='@(() => ThemeAsync(null))'>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4.5" width="18" height="12" rx="1.5" /><path d="M8.5 20h7M12 16.5V20" /></svg>
        @L.T("theme.system")
      </button>
    </div>
  </section>

  <section class="card" aria-labelledby="audio">
    <h2 id="audio">@L.T("settings.audio")</h2>
    <p class="muted small">@L.T("settings.audioHint")</p>
    @if (!Audio.IsSupported)
    {
      <p class="notice">@L.T("settings.audio.unsupported")</p>
    }
    else if (packs.Count == 0)
    {
      <p class="muted small">@L.T("settings.audio.none")</p>
    }
    else
    {
      <div class="pack-list">
        @foreach (var state in packs)
        {
          <div class="pack-row">
            <div class="pack-info">
              <div class="row listen-row">
                <b lang="en">@state.Pack.Title</b>
                <AudioSourceBadge Source="@(state.Pack.Kind == AudioPackKind.Official ? AudioSource.OfficialRecording : AudioSource.SyntheticPack)" />
              </div>
              <span class="muted small" lang="en">@state.Pack.Description · @L.T("common.sizeMB", AudioFormat.Megabytes(state.Pack.SizeBytes))</span>
              @if (state.Status == AudioPackStatus.Downloading)
              {
                <div class="row listen-row">
                  <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent(state)"><div style="width: @(Percent(state))%"></div></div>
                  <span class="muted small">@L.T("settings.audio.downloading", AudioFormat.Megabytes(state.BytesDone), AudioFormat.Megabytes(state.Pack.SizeBytes))</span>
                </div>
              }
              @if (state.Error is not null)
              {
                <p class="feedback bad" role="alert">@L.T("settings.audio.failed")</p>
              }
            </div>
            @if (state.Status == AudioPackStatus.NotDownloaded)
            {
              <button type="button" class="button primary" @onclick="() => DownloadAsync(state.Pack.Id)">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0l-4-4m4 4l4-4M5 19h14" /></svg>
                @L.T("settings.audio.download")
              </button>
            }
            else if (state.Status == AudioPackStatus.Downloading)
            {
              <button type="button" class="button ghost small" @onclick="() => Cancel(state.Pack.Id)">@L.T("settings.audio.cancel")</button>
            }
            else
            {
              <span class="pack-ready">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M4 12.5l5 5L20 6.5" /></svg>
                @L.T("settings.audio.ready")
              </span>
              <button type="button" class="button ghost small" @onclick="() => Audio.DeleteAsync(state.Pack.Id)">@L.T("settings.audio.delete")</button>
            }
          </div>
        }
      </div>
      <p class="muted small">@L.T("settings.audio.sources", string.Join(", ", packs.Select(p => p.Pack.BaseUrl.Host).Distinct()))</p>
    }
  </section>

  <section class="card" aria-labelledby="data">
    <h2 id="data">@L.T("settings.data")</h2>
    <p class="muted small">@L.T("settings.dataHint")</p>
    <div class="row">
      <button type="button" class="button" @onclick="ExportAsync">@L.T("settings.export")</button>
      @if (!confirmingDelete)
      {
        <button type="button" class="button ghost" @onclick="() => confirmingDelete = true">@L.T("settings.delete")</button>
      }
      else
      {
        <span>@L.T("settings.deleteConfirm")</span>
        <button type="button" class="button primary" @onclick="DeleteAsync">@L.T("common.yes")</button>
        <button type="button" class="button" @onclick="() => confirmingDelete = false">@L.T("common.no")</button>
      }
    </div>
    @if (message is not null)
    {
      <p class="notice ok" role="status" style="margin-block-start: .75rem">@message</p>
    }
  </section>

  <section class="card" aria-labelledby="privacy">
    <h2 id="privacy">@L.T("settings.privacy")</h2>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>@L.T("settings.privacy.feature")</th><th>@L.T("settings.privacy.where")</th></tr></thead>
        <tbody>
          <tr><td>@L.T("settings.privacy.f.profile")</td><td>@L.T("settings.privacy.local")</td></tr>
          <tr><td>@L.T("settings.privacy.f.questions")</td><td>@L.T("settings.privacy.local")</td></tr>
          <tr><td>@L.T("settings.privacy.f.progress")</td><td>@L.T("settings.privacy.local")</td></tr>
          <tr><td>@L.T("settings.privacy.f.check")</td><td>@L.T("settings.privacy.local")</td></tr>
          <tr><td>@L.T("settings.privacy.f.translations")</td><td>@L.T("settings.privacy.local")</td></tr>
          <tr><td>@L.T("settings.privacy.f.speech")</td><td>@L.T(speechIsLocal ? "settings.privacy.local" : "settings.privacy.browserVoice")</td></tr>
          <tr><td>@L.T("settings.privacy.f.recordings")</td><td>@(packs.Any(p => p.Status == AudioPackStatus.Ready) ? L.T("settings.privacy.packs", string.Join(", ", packs.Where(p => p.Status == AudioPackStatus.Ready).Select(p => p.Pack.BaseUrl.Host).Distinct())) : L.T("settings.privacy.packsNone"))</td></tr>
          <tr><td>@L.T("settings.privacy.f.ai")</td><td>@L.T("settings.privacy.notBuilt")</td></tr>
        </tbody>
      </table>
    </div>
  </section>
</div>

@code {
  private IReadOnlyList<ExamVersion> versions = [];
  private ExamVersion? resolved;
  private string filingDate = string.Empty;
  private string interviewDate = string.Empty;
  private string name = string.Empty;
  private bool confirmingDelete;

  // The speech row of "What runs where" is answered by the ISpeechService in use, not hard-coded:
  // the native hosts speak with the platform engine on the device, and a browser may use a local
  // or a network voice. Asked after the first render because the browser implementation needs JS
  // interop, which BlazorWebView only attaches once the first render has committed.
  private bool speechIsLocal;

  // Audio packs: the list and its per-pack state come from AudioService; downloads run there too,
  // so leaving this page does not cancel one.
  private IReadOnlyList<AudioPackState> packs = [];
  private readonly Dictionary<string, CancellationTokenSource> downloads = new(StringComparer.Ordinal);

  private static int Percent(AudioPackState state) => state.Pack.SizeBytes == 0 ? 0 : (int)Math.Min(100, 100 * state.BytesDone / state.Pack.SizeBytes);

  private async Task DownloadAsync(string packId)
  {
    var cts = new CancellationTokenSource();
    downloads[packId] = cts;
    try
    {
      await Audio.DownloadAsync(packId, cts.Token);
    }
    finally
    {
      downloads.Remove(packId);
      cts.Dispose();
    }
  }

  private void Cancel(string packId)
  {
    if (downloads.TryGetValue(packId, out var cts))
    {
      cts.Cancel();
    }
  }

  private void OnAudioChanged() => _ = InvokeAsync(async () => { packs = await Audio.GetStatesAsync(); StateHasChanged(); });

  public override void Dispose()
  {
    Audio.Changed -= OnAudioChanged;
    base.Dispose();
  }
  private string? message;
  private string? error;

  protected override async Task OnInitializedAsync()
  {
    Audio.Changed += OnAudioChanged;
    try
    {
      packs = await Audio.GetStatesAsync();
      versions = await Content.GetExamVersionsAsync();
      filingDate = Learner.Exam.FilingDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
      interviewDate = Learner.Exam.InterviewDate?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
      name = Learner.Name ?? string.Empty;
      Resolve();
    }
    catch (Exception ex) when (ex is HttpRequestException or ContentFormatException or FileNotFoundException)
    {
      error = ex.Message;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    try
    {
      speechIsLocal = await Speech.IsAvailableAsync() && await Speech.IsLocalVoiceAsync("en-US");
    }
    catch (Exception)
    {
      speechIsLocal = false;
    }

    StateHasChanged();
  }

  private static string StatusKey(TranslationReviewStatus status) => status switch
  {
    TranslationReviewStatus.Source => "source",
    TranslationReviewStatus.Reviewed => "reviewed",
    TranslationReviewStatus.Draft => "draft",
    _ => "machineDraft",
  };

  private void Resolve() =>
    resolved = Learner.Exam.VersionId is null && Learner.Exam.FilingDate is { } date ? ExamPolicy.Resolve(date, versions) : null;

  private async Task ProfileAsync(LanguageProfile profile)
  {
    await Learner.SetLanguageProfileAsync(profile);
    message = L.T("settings.saved");
  }

  private async Task FilingDateAsync(string? value)
  {
    filingDate = value ?? string.Empty;
    DateOnly? date = DateOnly.TryParseExact(filingDate, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed) ? parsed : null;
    await Learner.SetExamAsync(Learner.Exam with { FilingDate = date });
    Resolve();
    message = L.T("settings.saved");
  }

  private async Task VersionAsync(string? value)
  {
    await Learner.SetExamAsync(Learner.Exam with { VersionId = string.IsNullOrEmpty(value) ? null : value });
    Resolve();
    message = L.T("settings.saved");
  }

  private async Task SeniorAsync(bool value)
  {
    await Learner.SetExamAsync(Learner.Exam with { SeniorConsideration = value });
    message = L.T("settings.saved");
  }

  private async Task InterviewDateAsync(string? value)
  {
    interviewDate = value ?? string.Empty;
    DateOnly? date = DateOnly.TryParseExact(interviewDate, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed) ? parsed : null;
    await Learner.SetExamAsync(Learner.Exam with { InterviewDate = date });
    message = L.T("settings.saved");
  }

  private async Task NameAsync(string? value)
  {
    await Learner.SetNameAsync(value);
    name = Learner.Name ?? string.Empty;
    message = L.T("settings.saved");
  }

  private async Task ThemeAsync(string? theme)
  {
    await Learner.SetThemeAsync(theme);
    message = L.T("settings.saved");
  }

  private Task ExportAsync() => Exporter.ExportAsync("citiz-progress.json", Learner.Export()).AsTask();

  private async Task DeleteAsync()
  {
    confirmingDelete = false;
    await Learner.ClearAllAsync();
    filingDate = string.Empty;
    interviewDate = string.Empty;
    name = string.Empty;
    resolved = null;
    message = L.T("settings.deleted");
    await Browser.AnnounceAsync(message);
  }
}
