@inherits LocalizedComponentBase
@inject SpeechService Speech

<article class="card question-card">
  <div class="question-meta">
    <span class="muted">@L.T("prepare.questionNumber", Question.Number) · @Question.Subcategory</span>
    <ReviewBadge Status="Question.ReviewStatus" />
  </div>
  <p class="question-prompt" lang="en">@Question.Prompt</p>
  <button type="button" class="button ghost small" @onclick="SpeakAsync" aria-label="@L.T("common.listenAria")">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z" /></svg>
    @L.T("common.listen")
  </button>
  @ChildContent
</article>

@code {
  [Parameter, EditorRequired] public CivicsQuestion Question { get; set; } = default!;
  [Parameter] public RenderFragment? ChildContent { get; set; }

  private Task SpeakAsync() => Speech.SpeakAsync(Question.Prompt).AsTask();
}
