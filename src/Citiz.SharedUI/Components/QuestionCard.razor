@inherits LocalizedComponentBase
@inject AudioService Audio

<article class="card question-card">
  <div class="question-meta">
    <span class="muted">@L.T("prepare.questionNumber", Question.Number) · @Question.Subcategory</span>
    <ReviewBadge Status="Question.ReviewStatus" />
  </div>
  <p class="question-prompt" lang="en">@Question.Prompt</p>
  <div class="row listen-row">
    <button type="button" class="button ghost small" @onclick="SpeakAsync" aria-label="@L.T("common.listenAria")" disabled="@(source == AudioSource.None)">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z" /></svg>
      @L.T("common.listen")
    </button>
    @if (source == AudioSource.SyntheticPack)
    {
      <AudioSourceBadge Source="AudioSource.SyntheticPack" />
      <span class="muted small">@L.T("audio.listenSynthetic")</span>
    }
    else if (source == AudioSource.DeviceVoice)
    {
      <span class="muted small">@L.T("audio.listenDevice")</span>
    }
    else
    {
      <span class="muted small">@L.T("audio.listenNone")</span>
    }
  </div>
  @ChildContent
</article>

@code {
  [Parameter, EditorRequired] public CivicsQuestion Question { get; set; } = default!;
  [Parameter] public RenderFragment? ChildContent { get; set; }

  private AudioSource source = AudioSource.DeviceVoice;
  private string? sourceForId;

  protected override void OnInitialized() => Audio.Changed += OnAudioChanged;

  protected override async Task OnParametersSetAsync()
  {
    if (sourceForId != Question.Id)
    {
      sourceForId = Question.Id;
      source = await Audio.PromptSourceAsync(Question);
    }
  }

  private Task SpeakAsync() => Audio.PlayPromptAsync(Question);

  private void OnAudioChanged()
  {
    sourceForId = null;
    _ = InvokeAsync(async () => { await OnParametersSetAsync(); StateHasChanged(); });
  }

  public override void Dispose()
  {
    Audio.Changed -= OnAudioChanged;
    base.Dispose();
  }
}
