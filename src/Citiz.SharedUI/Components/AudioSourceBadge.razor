@inherits LocalizedComponentBase

@* Every clip says where it came from. Official recordings are the authority's own; synthetic clips
   were generated from the verified text and are never presented as official. *@
@if (Source == AudioSource.OfficialRecording)
{
  <span class="badge audio-official" title="@L.T("audio.badge.official")">
    <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5" /><path fill="currentColor" d="M12 7l1.5 3.2 3.5.4-2.6 2.4.7 3.5L12 14.8l-3.1 1.7.7-3.5L7 10.6l3.5-.4z" /></svg>
    @L.T("audio.badge.official")
  </span>
}
else if (Source == AudioSource.SyntheticPack)
{
  <span class="badge audio-synthetic" title="@L.T("audio.badge.synthetic")">@L.T("audio.badge.synthetic")</span>
}

@code {
  [Parameter, EditorRequired] public AudioSource Source { get; set; }
}
