@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationService L
@inject LearnerState Learner
@inject StudyService Study

<a class="skip-link" href="#main">@L.T("nav.skip")</a>

<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="" aria-label="@L.T("app.name")">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M16 2 4 7v9c0 7.2 5.1 13 12 14 6.9-1 12-6.8 12-14V7L16 2z" fill="currentColor" opacity=".18" />
        <path d="M16 6.2 8 9.5v6.3c0 4.7 3.3 8.7 8 9.8 4.7-1.1 8-5.1 8-9.8V9.5l-8-3.3z" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="m16 11 1.6 3.3 3.6.5-2.6 2.5.6 3.6-3.2-1.7-3.2 1.7.6-3.6-2.6-2.5 3.6-.5z" fill="currentColor" />
      </svg>
      <span class="brand-text">
        <span class="brand-name">@L.T("app.name")</span>
        <span class="brand-tagline">@L.T("app.tagline")</span>
      </span>
    </a>

    <nav class="side-nav" aria-label="@L.T("nav.label")">
      @foreach (var item in NavItems)
      {
        <NavLink class="nav-item" href="@item.Href" Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
          <span class="nav-icon" aria-hidden="true">@item.Icon</span>
          <span>@L.T(item.LabelKey)</span>
          @if (item.IsNew)
          {
            <span class="badge nav-new">@L.T("nav.new")</span>
          }
        </NavLink>
      }
    </nav>

    @if (passport is not null)
    {
      <div class="passport-card">
        <span class="passport-icon" aria-hidden="true">@IconTrophy</span>
        <div class="passport-title">@L.T("home.passport.title")</div>
        <p class="passport-summary">@L.T("home.passport.summary", passport.Value.Mastered, passport.Value.Total)</p>
        <progress value="@passport.Value.Mastered" max="@Math.Max(passport.Value.Total, 1)" class="passport-bar"></progress>
      </div>
    }
  </aside>

  <div class="main-col">
    <header class="topbar">
      <span class="brand-mobile" aria-hidden="true">
        <svg class="brand-mark" viewBox="0 0 32 32" focusable="false">
          <path d="M16 2 4 7v9c0 7.2 5.1 13 12 14 6.9-1 12-6.8 12-14V7L16 2z" fill="currentColor" opacity=".18" />
          <path d="M16 6.2 8 9.5v6.3c0 4.7 3.3 8.7 8 9.8 4.7-1.1 8-5.1 8-9.8V9.5l-8-3.3z" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="m16 11 1.6 3.3 3.6.5-2.6 2.5.6 3.6-3.2-1.7-3.2 1.7.6-3.6-2.6-2.5 3.6-.5z" fill="currentColor" />
        </svg>
        <span class="brand-name">@L.T("app.name")</span>
      </span>
      <div class="topbar-tools">
        <LanguageSelect />
        <NavLink class="icon-link" href="settings" title="@L.T("nav.settings")" aria-label="@L.T("nav.settings")">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M19.4 13a7.7 7.7 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.6 7.6 0 0 0-1.7-1L15 3.2H9l-.4 2.7a7.6 7.6 0 0 0-1.7 1l-2.5-1-2 3.5L4.6 11a7.7 7.7 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1a7.6 7.6 0 0 0 1.7 1l.4 2.7h6l.4-2.7a7.6 7.6 0 0 0 1.7-1l2.5 1 2-3.5L19.4 13zM12 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z" /></svg>
        </NavLink>
      </div>
    </header>

    <main id="main" class="content" tabindex="-1">
      @if (Learner.IsInitialized)
      {
        @Body
      }
      else
      {
        <Loading />
      }
    </main>

    <footer class="footer">
      <span class="privacy-pill" title="@L.T("privacy.localTitle")">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><path fill="currentColor" d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4V6z" /></svg>
        @L.T("privacy.local")
      </span>
      <span>@L.T("footer.notice")</span>
      <a href="about">@L.T("nav.about")</a>
    </footer>
  </div>

  <nav class="bottom-nav" aria-label="@L.T("nav.label")">
    @foreach (var item in NavItems)
    {
      <NavLink class="tab" href="@item.Href" Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
        <span class="nav-icon" aria-hidden="true">@item.Icon</span>
        <span class="tab-label">@L.T(item.LabelKey)</span>
      </NavLink>
    }
  </nav>
</div>

<div id="citiz-live" class="sr-only" aria-live="polite" aria-atomic="true"></div>

@code {
  private static readonly MarkupString IconHome = new(
    "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 11.5 12 5l8 6.5\"/><path d=\"M6 10v8.5a1 1 0 0 0 1 1h3.2v-5h3.6v5H17a1 1 0 0 0 1-1V10\"/></svg>");

  private static readonly MarkupString IconTarget = new(
    "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><circle cx=\"12\" cy=\"12\" r=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"1.5\" fill=\"currentColor\" stroke=\"none\"/></svg>");

  private static readonly MarkupString IconChat = new(
    "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12a8 8 0 1 1 3.8 6.8L4 20l1.3-3.6A7.96 7.96 0 0 1 4 12Z\"/></svg>");

  private static readonly MarkupString IconCompass = new(
    "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"m15 9-2 5-4.5 2 2-5z\" fill=\"currentColor\" stroke=\"none\"/></svg>");

  private static readonly MarkupString IconGamepad = new(
    "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9h12a3 3 0 0 1 3 3.4l-.6 3.4a2.6 2.6 0 0 1-4.6 1.1L15 16H9l-.8.9a2.6 2.6 0 0 1-4.6-1.1L3 12.4A3 3 0 0 1 6 9Z\"/><path d=\"M7.5 11v2.4M6.3 12.2h2.4\"/><circle cx=\"16\" cy=\"11.5\" r=\".9\" fill=\"currentColor\" stroke=\"none\"/><circle cx=\"18\" cy=\"13.5\" r=\".9\" fill=\"currentColor\" stroke=\"none\"/></svg>");

  private static readonly MarkupString IconTrophy = new(
    "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 4.5h10V8a5 5 0 0 1-10 0V4.5Z\"/><path d=\"M7 5.3H4.3A2.6 2.6 0 0 0 7 8.7\"/><path d=\"M17 5.3h2.7A2.6 2.6 0 0 1 17 8.7\"/><path d=\"M9.2 20h5.6\"/><path d=\"M12 13v4.5\"/></svg>");

  private sealed record NavItem(string Href, string LabelKey, MarkupString Icon, bool IsNew = false);

  private static readonly NavItem[] NavItems =
  [
    new("", "nav.home", IconHome),
    new("prepare", "nav.prepare", IconTarget),
    new("communicate", "nav.communicate", IconChat),
    new("discover", "nav.discover", IconCompass, IsNew: true),
    new("games", "nav.games", IconGamepad),
  ];

  private (int Mastered, int Total)? passport;

  protected override void OnInitialized()
  {
    L.Changed += StateHasChanged;
    Learner.Changed += StateHasChanged;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender)
    {
      return;
    }

    // JS interop needs the WebView's bridge, which a MAUI BlazorWebView only attaches after the
    // first render commits (unlike WASM, where it's available immediately) — so this runs here
    // instead of OnInitializedAsync, which is correct for every host.
    await Learner.InitializeAsync();

    try
    {
      var context = await Study.GetContextAsync();
      passport = (Learner.Progress.MasteredCount, context.Bank.Count);
    }
    catch (Exception ex) when (ex is HttpRequestException or FileNotFoundException)
    {
      passport = null;
    }

    StateHasChanged();
  }

  public void Dispose()
  {
    L.Changed -= StateHasChanged;
    Learner.Changed -= StateHasChanged;
  }
}
